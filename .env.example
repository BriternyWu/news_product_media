# =============================================================
# 环境变量样例（不含真实密钥，可提交到 Git）
# 复制为 .env.local 后填入你自己的真实值；.env.local 已被 .gitignore 忽略，绝不提交。
# =============================================================
#
# 如何接入真实数据（三步）：
#   1. 把本文件复制为 .env.local；
#   2. 填入真实的 APP_COZE_API_TOKEN 与 COZE_WORKFLOW_ID（见下方，别填真实值到本模板）；
#   3. 把 COZE_USE_MOCK 改为 false。
#
# 未配置任何密钥时，程序会自动回退到 Mock 模拟数据（不报错、不崩溃）。

# 扣子工作流访问令牌（App 级 PAT）—— 仅服务端使用，绝不下发前端
# 兼容旧名 COZE_API_TOKEN；新项目请用 APP_COZE_API_TOKEN
APP_COZE_API_TOKEN=

# 扣子工作流 ID
COZE_WORKFLOW_ID=

# 扣子 API 地址（默认国内站，按你的账号区域改）
COZE_BASE_URL=https://api.coze.cn

# 工作流入参键名（真实工作流里 keyword 参数的实际字段名，默认 keyword）
COZE_WORKFLOW_INPUT_KEY=keyword

# 运行模式开关：
#   true  → 强制 Mock（公开演示默认）
#   false → 走真实 API（需同时填好上面的令牌与工作流 ID，否则仍自动降级 Mock）
COZE_USE_MOCK=true
